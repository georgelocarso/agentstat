{
  "name": "agentstat-monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "Lightweight monitoring daemon and real-time dashboard companion for AI coding agents",
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "dev": "pnpm --filter @agentstat/daemon run dev",
    "start": "pnpm --filter @agentstat/daemon run dev start",
    "dev:daemon": "pnpm --filter @agentstat/daemon run dev",
    "dev:web": "pnpm --filter @agentstat/web run dev"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
